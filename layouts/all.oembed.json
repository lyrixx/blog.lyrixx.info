{{- /* Slack and Mastodon read the oEmbed of a page before its Open Graph tags: it gives them the square image. */ -}}
{{- $square := partial "square-image.html" . -}}
{{- dict
  "author_name" site.Title
  "author_url" site.Home.Permalink
  "provider_name" site.Title
  "provider_url" site.Home.Permalink
  "thumbnail_height" $square.Height
  "thumbnail_url" $square.Permalink
  "thumbnail_width" $square.Width
  "title" (or .Title site.Title | plainify)
  "type" "link"
  "version" "1.0"
  | jsonify -}}
